# Copy to .env and fill in. Never commit .env.
# Vesta/Gizwits account (the one the cooker is bound to in the app):
GIZ_USER=you@example.com
# App caps passwords at 16 chars (maxLength) — only the first 16 are used.
GIZ_PASS=secret
# ...or paste uid/token directly (skip login):
# GIZ_UID=
# GIZ_TOKEN=
# Optional: pin device + region. Default API is US; use https://euapi.gizwits.com if EU account.
# GIZ_DID=
GIZ_API=https://usapi.gizwits.com
GIZ_APPID=9a6d8b3d46a246fca38dea306f98e19e
# Local MQTT:
MQTT_HOST=mosquitto
MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
POLL_INTERVAL=20
